rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── foyers ──────────────────────────────────────────────────────────────
    match /foyers/{foyerId} {

      allow read: if request.auth != null
                  && request.auth.uid in resource.data.membres;

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.membres
                    && request.resource.data.membres.size() == 1;

      allow update: if request.auth != null && (

        // Branche 1 — jonction avec code valide
        (
          !(request.auth.uid in resource.data.membres)
          && request.auth.uid in request.resource.data.membres
          && request.resource.data.membres.size() == resource.data.membres.size() + 1
          && request.resource.data.membres.size() <= 6
          && request.resource.data.codeJonction == resource.data.codeActif
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['membres', 'prenoms', 'codeJonction'])
        )

        // Branche 2 — retrait de soi-même uniquement
        || (
          request.auth.uid in resource.data.membres
          && !(request.auth.uid in request.resource.data.membres)
          && resource.data.membres.toSet().difference(
               request.resource.data.membres.toSet()
             ) == [request.auth.uid].toSet()
        )

        // Branche 3 — mise à jour par un membre (config foyer)
        || (
          request.auth.uid in resource.data.membres
          && request.auth.uid in request.resource.data.membres
          && request.resource.data.membres.hasAll(resource.data.membres)
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['codeActif', 'terme', 'toxoStatus', 'budgetMensuel',
                         'derniereVerifKit', 'prenoms', 'nom'])
        )
      );

      allow delete: if false;

      // ── Sous-collections ──────────────────────────────────────────────────
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid in get(
                                /databases/$(database)/documents/foyers/$(foyerId)
                              ).data.membres;
      }
    }

    // ── codes ────────────────────────────────────────────────────────────────
    match /codes/{code} {
      allow get:    if request.auth != null;
      allow list:   if false;
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/codes/$(code))
                    && request.auth.uid in getAfter(
                         /databases/$(database)/documents/foyers/$(request.resource.data.foyerId)
                       ).data.membres;
      allow update, delete: if false;
    }

    // Tout le reste refusé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
